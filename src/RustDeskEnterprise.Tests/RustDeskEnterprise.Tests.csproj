      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RustDeskEnterprise.Shared/RustDeskEnterprise.Shared.csproj" />
    <ProjectReference Include="../RustDeskEnterprise.Configuration/RustDeskEnterprise.Configuration.csproj" />
    <ProjectReference Include="../RustDeskEnterprise.Logging/RustDeskEnterprise.Logging.csproj" />
  </ItemGroup>

</Project>
